<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Account</field>
        <field>Branch__c</field>
        <field>VoD_in_crore__c</field>
        <field>IRF_Final_Amount__c</field>
        <field>ASF_Final_Amount__c</field>
        <field>Instrument_type_4__c</field>
        <field>Owner</field>
        <field>Modification_in_Fee_and_Invoice_Clause__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved_by_CH</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Legal_and_Com_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Commercial_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Commercial Head Approval</label>
        <name>Step_1</name>
        <rejectionActions>
            <action>
                <name>Fee_MPRA_SOW_2_3</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Opp_Rejected_by_CH</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>Opp_Approvals_templates/OFAC_approval_assignment</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.Mandate_Type__c</field>
            <operation>equals</operation>
            <value>Fresh From Poached,Fresh From Fresh</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Commercial_Head__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>notEqual</operation>
            <value>Negotiation</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>CH_Approval_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Commercial Head Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
