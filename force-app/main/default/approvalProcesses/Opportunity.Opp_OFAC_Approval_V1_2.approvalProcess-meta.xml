<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>sales@icraindia.info</submitter>
        <type>user</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Account</field>
        <field>Branch__c</field>
        <field>Business_Sector__c</field>
        <field>Instrument_type_4__c</field>
        <field>VoD_in_crore__c</field>
        <field>IRF_Final_Amount__c</field>
        <field>ASF_Final_Amount__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>OFAC_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>OFAC_Post_Approval_Notification</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Opp_Approved_by_OFAC</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>OFAC_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>OFAC Approval</label>
        <name>Step_1</name>
        <rejectionActions>
            <action>
                <name>OFAC_Post_Reject_Notification</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Opp_Lost_after_OFAC_rejection</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>ICRA/OFAC_Approval_Email</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Upload_OFAC_Document_for_Approval_Process</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Opp OFAC Approval new</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
