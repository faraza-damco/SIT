<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Payment_Terms__c</field>
        <field>Delayed_Payment_Interest_Rate__c</field>
        <field>Surveillance_Fee_Revision_Maximum_new__c</field>
        <field>Other__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Commercial_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>CH Approval Request</label>
        <name>CH_Approval_Request</name>
    </approvalStep>
    <emailTemplate>unfiled$public/CH_Approval_for_Comm_Legal_Clauses</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Update_CH_Approval_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Stage_to_Commercial_Head_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_CH_Approval_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Delayed_Payment_on_Rejection</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Other_Value_on_Rejection</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Payment_Terms_on_Rejection</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Stage_to_Executive_Meeting</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Surveillance_Fee_on_Rejection</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>CH Approval for Comm &amp; Legal Clauses</label>
    <processOrder>9</processOrder>
    <recallActions>
        <action>
            <name>Update_CH_Approval_Status_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
