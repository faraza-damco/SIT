            <action>
                <name>Opp_Lost_after_OFAC_rejection</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.Mandate_Type__c</field>
            <operation>equals</operation>
