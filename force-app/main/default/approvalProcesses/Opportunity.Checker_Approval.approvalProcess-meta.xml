<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Account</field>
        <field>Branch__c</field>
        <field>Business_Sector__c</field>
        <field>Mandate_Type__c</field>
        <field>GST_Number__c</field>
        <field>PAN_Number__c</field>
        <field>TAN_Number__c</field>
        <field>IRF_Final_Amount__c</field>
        <field>ASF_Final_Amount__c</field>
        <field>Owner</field>
        <field>Instrument_type_4__c</field>
        <field>VoD_in_crore__c</field>
        <field>Mandate_Received_Date__c</field>
        <field>MPRA_Sent_Date__c</field>
        <field>SOW_Effective_Date__c</field>
        <field>MPRA_SoW_Reference_Number_iflow__c</field>
        <field>Customer_Fee_Type__c</field>
        <field>Rated_Entity__c</field>
        <field>Bill_To__c</field>
        <field>BD_Team_Classification__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Opportunity_is_Approved</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_the_Stage_to_Closed_Won</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Opportunity_Checker__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Checker Approval</label>
        <name>IC_Approval</name>
        <rejectionActions>
            <action>
                <name>Opportunity_is_Rejected</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_the_Stage_to_MPRA_Form_Re</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>This approval process is fired when the opportunity stage is &apos;Checker Approval&apos;</description>
    <emailTemplate>unfiled$public/Checker_Approval</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Approval_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_IC_Approved_Field</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Approval_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_IC_Approved_Field_on_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Approval_Status_Pending</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Checker_Approval_Email_to_team_members</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Checker Approval</label>
    <processOrder>6</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
