<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Defer_Billing_or_Exit_Case__c</field>
        <field>Expected_Deferred_Date__c</field>
        <field>ASF_Final_Amount__c</field>
        <field>Amount_to_Be_Billed__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Team_Leader__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>TL: Hold Approval</label>
        <name>TL_Hold_Approval</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>BD_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>BSH: Hold Approval</label>
        <name>BSH_Hold_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Commercial_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>CBO: Hold Approval</label>
        <name>CBO</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>ramnath.krishnan@icraindia.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>MD and CEO: Hold Approval</label>
        <name>MD</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.RecordType</field>
            <operation>equals</operation>
            <value>Surveillance</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Reason__c</field>
            <operation>equals</operation>
            <value>Hold</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Reset_Approval_Process_Value</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_to_Hold</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Reset_Approval_Process_Value</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Date_of_Hold_till</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Hold_Reason</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Revised_Rating_VoD</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Revised_Surveillance_Fee</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Reset_the_Ready_for_Approval_Value</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Last_Submitted_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Hold- To be Billed Status Approval</label>
    <processOrder>10</processOrder>
    <recallActions>
        <action>
            <name>Reset_Approval_Process_Value</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Date_of_Hold_till</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Hold_Reason</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Revised_Rating_VoD</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Revised_Surveillance_Fee</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
