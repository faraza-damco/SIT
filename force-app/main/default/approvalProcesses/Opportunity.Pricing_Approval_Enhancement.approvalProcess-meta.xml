<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Account</field>
        <field>BD_Team_Classification__c</field>
        <field>Branch__c</field>
        <field>VoD_in_crore__c</field>
        <field>Mandate_Type__c</field>
        <field>Instrument_type_4__c</field>
        <field>Target_Fee_IRF__c</field>
        <field>Annual_Surveillance_Fee_as_per_Framework__c</field>
        <field>Proposed_Rating_Fee__c</field>
        <field>Proposed_Surveillance_Fee__c</field>
        <field>Deviation_IRF_Percent__c</field>
        <field>Deviation_ASF_Percent__c</field>
        <field>Proposed_Yield_IRF__c</field>
        <field>Proposed_Yield_ASF__c</field>
        <field>Reason_for_Discount__c</field>
        <field>Detailed_Comment__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Pricing_Approved_By_Business_Head</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>BD_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>(3 AND 1) OR (3 AND 2) OR (3 AND 5) OR (3 AND 4)</booleanFilter>
            <criteriaItems>
                <field>Opportunity.BD_Head_Approval_PA__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.Instrument_type_2__c</field>
                <operation>equals</operation>
                <value>Others</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.Pricing_Approved_by_Business_Head__c</field>
                <operation>notEqual</operation>
                <value>True</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.VoD_in_crore__c</field>
                <operation>greaterThan</operation>
                <value>5000</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.Ownership_Type_Picklist__c</field>
                <operation>equals</operation>
                <value>Government</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>BD Head Approval</label>
        <name>BD_Head_Approval</name>
        <rejectionActions>
            <action>
                <name>Pricing_Rejected_By_Business_Head</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Pricing_Approved_by_CH</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>shivakumar@icraindia.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>(1 AND 2) OR (1 AND 3) OR (1 AND 4) OR (1 AND 5)</booleanFilter>
            <criteriaItems>
                <field>Opportunity.Pricing_Approved_by_Commercial_Head__c</field>
                <operation>notEqual</operation>
                <value>True</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.CBO_Approval_PA__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.VoD_in_crore__c</field>
                <operation>greaterThan</operation>
                <value>5000</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.Ownership_Type_Picklist__c</field>
                <operation>equals</operation>
                <value>Government</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.Instrument_type_2__c</field>
                <operation>equals</operation>
                <value>Others</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>CBO Approval</label>
        <name>Commercial_Head_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Clear_Business_Head_Approval</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Pricing_Approved_by_CEO</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>ramnath.krishnan@icraindia.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>(4 AND 1) OR (4 AND 2) OR (4 AND 3) OR (4 AND 5)</booleanFilter>
            <criteriaItems>
                <field>Opportunity.MD_CEO_Approval_PA__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.VoD_in_crore__c</field>
                <operation>greaterThan</operation>
                <value>5000</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.Ownership_Type_Picklist__c</field>
                <operation>equals</operation>
                <value>Government</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.Pricing_Approved_by_CEO__c</field>
                <operation>notEqual</operation>
                <value>True</value>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity.Instrument_type_2__c</field>
                <operation>equals</operation>
                <value>Others</value>
            </criteriaItems>
        </entryCriteria>
        <label>CEO Approval</label>
        <name>CEO_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Clear_Business_Head_Approval</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Clear_CH_Approval</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Pricing_Rejected_By_CEO</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>To get approval from Commercial Head and then CEO whenever opportunity is in Negotiation and pricing is not auto approved. Adding approval/rejection emails</description>
    <emailTemplate>unfiled$public/Pricing_Approval_Mandates</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.Pricing_Not_Auto_Approved__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Negotiation</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_Opportunity_Stage</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Clear_ASF_as_per_Framework</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Deviation_ASF</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Deviation_IRF</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Initial_Rating_as_per_Framework</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Pricing_Not_Auto_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Proposed_RF</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Proposed_SF</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Chechbox</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Clear_BH_Mail_Sent</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_BH_Pricing_Rejection</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_CH_Mail_Sent</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_CH_Pricing_Rejection</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_MD_Mail_Sent</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_MD_Pricing_Rejection</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Pricing Approval</label>
    <processOrder>8</processOrder>
    <recallActions>
        <action>
            <name>Clear_ASF_as_per_Framework</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Deviation_ASF</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Deviation_IRF</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Initial_Rating_as_per_Framework</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Pricing_Not_Auto_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Proposed_RF</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Proposed_SF</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Chechbox</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
