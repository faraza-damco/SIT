    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunities</targetReference>
        </connector>
        <filterFormula>OR(
    AND(
        ISNEW(),
		{!$Record.RecordType.DeveloperName}=&apos;Surveillance&apos;,
		ISPICKVAL({!$Record.Defer_Billing_or_Exit_Case__c}, &apos;To Be Billed&apos;)
    ),
	OR(
		AND(
			ISCHANGED({!$Record.Defer_Billing_or_Exit_Case__c}),
			ISPICKVAL({!$Record.Defer_Billing_or_Exit_Case__c}, &apos;Exit Case&apos;),
			NOT(ISPICKVAL(PRIORVALUE({!$Record.Defer_Billing_or_Exit_Case__c}), &apos;Exit Case&apos;))
		),
		AND(
			ISCHANGED({!$Record.Defer_Billing_or_Exit_Case__c}),
			ISPICKVAL({!$Record.Defer_Billing_or_Exit_Case__c}, &apos;Already Billed&apos;),
			NOT(ISPICKVAL(PRIORVALUE({!$Record.Defer_Billing_or_Exit_Case__c}), &apos;Already Billed&apos;)),
			{!$Record.RecordType.DeveloperName}=&apos;Surveillance&apos;		
		),
		AND(
			ISCHANGED({!$Record.Defer_Billing_or_Exit_Case__c}),
			ISPICKVAL({!$Record.Defer_Billing_or_Exit_Case__c}, &apos;To Be Billed&apos;),
			NOT(ISPICKVAL(PRIORVALUE({!$Record.Defer_Billing_or_Exit_Case__c}), &apos;To Be Billed&apos;)),
			{!$Record.RecordType.DeveloperName}=&apos;Surveillance&apos;		
		),
		AND(
			ISCHANGED({!$Record.StageName}),
			ISPICKVAL({!$Record.StageName}, &apos;Closed Lost&apos;),
			NOT(ISPICKVAL(PRIORVALUE({!$Record.StageName}), &apos;Closed Lost&apos;))
		),
		AND(
			ISBLANK({!$Record__Prior.PR_Date__c}), 
			NOT(ISBLANK({!$Record.PR_Date__c})), 
			{!$Record.RecordType.DeveloperName}!=&apos;Surveillance&apos;
		),
		AND(
			ISBLANK({!$Record__Prior.Date_of_Communication__c}), 
			NOT(ISBLANK({!$Record.Date_of_Communication__c})), 
			{!$Record.RecordType.DeveloperName}!=&apos;Surveillance&apos;
		)
	),
    ISCHANGED({!$Record.VoD_in_crore__c}),
    ISCHANGED({!$Record.Size_to_be_rated_this_year_in_Cr_M__c})
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
