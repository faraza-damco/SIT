    <decisions>
        <name>Check_Condition</name>
        <label>Check Condition</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_for_Approval</name>
            <conditionLogic>(1) OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Proforma_Invoice_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Proforma_Invoice_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PI Pending with Finance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_Finance_User</targetReference>
            </connector>
            <label>Send for Approval</label>
        </rules>
        <rules>
            <name>PI_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Proforma_Invoice_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Proforma_Invoice_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PI Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_INVLI_records_rej</targetReference>
            </connector>
            <label>PI Approved</label>
        </rules>
        <rules>
            <name>PI_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Proforma_Invoice_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Proforma_Invoice_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PI Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_INVLI_records</targetReference>
            </connector>
            <label>PI Rejected</label>
        </rules>
