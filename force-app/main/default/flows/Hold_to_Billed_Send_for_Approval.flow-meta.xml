    <start>
        <locationX>1046</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Approval_Details</targetReference>
        </connector>
        <filterFormula>AND(
        {!$Record.RecordType.Name} = &quot;Surveillance&quot;,
        {!$Record.Bypass_Validation__c}=false,
	OR(
		AND(
			ISCHANGED({!$Record.Reason__c}),
			TEXT(PRIORVALUE({!$Record.Reason__c})) &lt;&gt; &quot;Hold&quot;,
			TEXT({!$Record.Reason__c}) = &quot;Hold&quot;,
			NOT(ISBLANK({!$Record.Hold_Up_Untill__c}))
		),
		AND(
			ISCHANGED({!$Record.Non_Cooperation_Reason__c}),
                        NOT(ISPICKVAL(({!$Record.Non_Cooperation_Reason__c}), &apos;&apos;))
		),
		AND(
			ISCHANGED({!$Record.Non_Cooperation_Withdrawal_Reason__c}),
                        NOT(ISPICKVAL(({!$Record.Non_Cooperation_Withdrawal_Reason__c}), &apos;&apos;))
		),
		AND(
			ISCHANGED({!$Record.Requested_Fee__c}),
			NOT(ISCHANGED({!$Record.Non_Cooperation_Reason__c})),
			NOT(ISCHANGED({!$Record.Non_Cooperation_Withdrawal_Reason__c})),
			NOT(ISCHANGED({!$Record.Reason__c}))
		)
	)
)</filterFormula>
