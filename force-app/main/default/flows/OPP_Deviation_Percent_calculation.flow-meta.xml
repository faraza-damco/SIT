<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Deviation_Percentage</name>
        <label>Check Deviation Percentage</label>
        <locationX>380</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Present0</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Deviation_ASF_Percent__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Deviation_IRF_Percent__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Pricing_Approval_Record</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Pricing_Approval</name>
        <label>Check Pricing Approval</label>
        <locationX>182</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Pricing_Approval_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DevationASF</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Annual_Surveillance_Fee_as_per_Framework__c}-{!$Record.Proposed_Surveillance_Fee__c})/{!$Record.Annual_Surveillance_Fee_as_per_Framework__c}*100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DeviationIRFpercent</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Target_Fee_IRF__c}-{!$Record.Proposed_Rating_Fee__c})/{!$Record.Target_Fee_IRF__c}*100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varDeviation</name>
        <dataType>Number</dataType>
        <expression>MAX((IF(ISBLANK({!$Record.Deviation_ASF_Percent__c}),0,{!$Record.Deviation_ASF_Percent__c})),
(IF(ISBLANK({!$Record.Deviation_IRF_Percent__c}),0,{!$Record.Deviation_IRF_Percent__c})))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>OPP Deviation Percent calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OPP Deviation Percent calculation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the Pricing Approval record based on the Deviation Percentage</description>
        <name>Get_Pricing_Approval_Record</name>
        <label>Get Pricing Approval Record</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Pricing_Approval</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Minimum_Deviation__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>varDeviation</elementReference>
            </value>
        </filters>
        <filters>
            <field>Maximum_Deviation__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>varDeviation</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pricing_Approval__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Deviation_IRF_Percent</name>
        <label>Deviation IRF Percent</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Check_Deviation_Percentage</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Target_Fee_IRF__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Annual_Surveillance_Fee_as_per_Framework__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Deviation_ASF_Percent__c</field>
            <value>
                <elementReference>DevationASF</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Deviation_IRF_Percent__c</field>
            <value>
                <elementReference>DeviationIRFpercent</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opportunity</name>
