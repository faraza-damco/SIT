        <locationY>0</locationY>
        <connector>
            <targetReference>Deviation_IRF_Percent</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND (4 OR 5) AND (6 OR 7)</filterLogic>
        <filters>
