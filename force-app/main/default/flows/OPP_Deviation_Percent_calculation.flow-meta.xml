                <elementReference>Get_Pricing_Approval_Record.BD_Head_Approval__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CBO_Approval_PA__c</field>
            <value>
                <elementReference>Get_Pricing_Approval_Record.CBO_Approval__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MD_CEO_Approval_PA__c</field>
            <value>
                <elementReference>Get_Pricing_Approval_Record.MD_CEO_Approval__c</elementReference>
