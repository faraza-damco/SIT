        </inputAssignments>
        <inputAssignments>
            <field>Maximum_Deviation_PA__c</field>
            <value>
                <elementReference>Get_Pricing_Approval_Record.Maximum_Deviation__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Minimum_Deviation_PA__c</field>
            <value>
                <elementReference>Get_Pricing_Approval_Record.Minimum_Deviation__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
