    <formulas>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS(LOWER($Flow.FaultMessage), &apos;error occurred:&apos;),
    TRIM(
        LEFT(
            MID(
                $Flow.FaultMessage,
                FIND(&apos;error occurred:&apos;, LOWER($Flow.FaultMessage)) + 15,
                LEN($Flow.FaultMessage)
            ),
            IF(
                CONTAINS(MID(
                    $Flow.FaultMessage,
                    FIND(&apos;error occurred:&apos;, LOWER($Flow.FaultMessage)) + 15,
                    LEN($Flow.FaultMessage)
                ), &apos;You can look up ExceptionCode&apos;),
                FIND(&apos;You can look up ExceptionCode&apos;, MID(
                    $Flow.FaultMessage,
                    FIND(&apos;error occurred:&apos;, LOWER($Flow.FaultMessage)) + 15,
                    LEN($Flow.FaultMessage)
                )) - 1,
                IF(
                    CONTAINS(
                        MID(
                            $Flow.FaultMessage,
                            FIND(&apos;error occurred:&apos;, LOWER($Flow.FaultMessage)) + 15,
                            LEN($Flow.FaultMessage)
                        ),
                        &apos;(&apos;
                    ),
                    FIND(&apos;(&apos;, MID(
                        $Flow.FaultMessage,
                        FIND(&apos;error occurred:&apos;, LOWER($Flow.FaultMessage)) + 15,
                        LEN($Flow.FaultMessage)
                    )) - 1,
                    LEN($Flow.FaultMessage)
                )
            )
        )
    ),
    $Flow.FaultMessage
)</expression>
    </formulas>
