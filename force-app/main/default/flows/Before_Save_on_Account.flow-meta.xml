    <recordLookups>
        <description>Get the accounts with same PAN Number from the account list where the account status is &apos;Active&apos;</description>
        <name>Get_the_accounts_with_same_PAN_Number</name>
        <label>Get the accounts with same PAN Number</label>
        <locationX>545</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_for_the_accounts_with_duplicate_PAN_Number</targetReference>
        </connector>
        <filterLogic>(1 OR 5) AND 2 AND 3 AND 4</filterLogic>
        <filters>
            <field>Account_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>PAN_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PAN_Number__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PAN_Number__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Account_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>OFAC Pending</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>PAN_Number__c</queriedFields>
        <queriedFields>Account_Status__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
