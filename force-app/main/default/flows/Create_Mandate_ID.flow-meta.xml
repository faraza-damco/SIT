    <environments>Default</environments>
    <formulas>
        <description>FY</description>
        <name>FinancialYear</name>
        <dataType>String</dataType>
        <expression>IF(
AND(TODAY() &gt;= DATE(YEAR(TODAY()),04,01),
TODAY()&lt;= DATE(YEAR(TODAY())+1 ,03,31)),
RIGHT(Text(YEAR( TODAY())), 2) + RIGHT(Text(YEAR( TODAY())+1), 2) , RIGHT(Text(YEAR( TODAY())-1), 2) + RIGHT(Text(YEAR( TODAY())), 2))</expression>
    </formulas>
    <formulas>
        <description>The combination CreatedDate year and Mandate Serial No of the latest record plus one</description>
        <name>MandateID</name>
        <dataType>String</dataType>
        <expression>{!FinancialYear}&amp;&apos;2&apos;&amp;{!MandateSerialWithZeroes}&amp;
TEXT(IF(ISBLANK({!Get_the_latest_opportunity.Mandate_Serial_No__c}), 
1, 
VALUE({!Get_the_latest_opportunity.Mandate_Serial_No__c})+1))</expression>
    </formulas>
    <formulas>
        <name>MandateID_Reset</name>
        <dataType>String</dataType>
        <expression>{!FinancialYear}&amp;&apos;2000&apos;&amp;&apos;1&apos;</expression>
    </formulas>
    <formulas>
        <name>MandateSerialNumber</name>
        <dataType>String</dataType>
        <expression>TEXT(IF(ISBLANK({!Get_the_latest_opportunity.Mandate_Serial_No__c}), 
1, 
VALUE({!Get_the_latest_opportunity.Mandate_Serial_No__c})+1))</expression>
    </formulas>
    <formulas>
        <name>MandateSerialWithZeroes</name>
        <dataType>String</dataType>
        <expression>      IF(VALUE({!Get_the_latest_opportunity.Mandate_Serial_No__c})=9,&apos;00&apos;,
      IF(VALUE({!Get_the_latest_opportunity.Mandate_Serial_No__c})=99,&apos;0&apos;,
      IF(VALUE({!Get_the_latest_opportunity.Mandate_Serial_No__c})=999,&apos;null&apos;,
      IF(VALUE({!Get_the_latest_opportunity.Mandate_Serial_No__c})=9999,null,
      IF(LEN({!Get_the_latest_opportunity.Mandate_Serial_No__c})=1,&apos;000&apos;,
      IF(LEN({!Get_the_latest_opportunity.Mandate_Serial_No__c})=2,&apos;00&apos;,
      IF(LEN({!Get_the_latest_opportunity.Mandate_Serial_No__c})=3,&apos;0&apos;,
      IF(LEN({!Get_the_latest_opportunity.Mandate_Serial_No__c})=4,&apos;null&apos;,
         &apos;&apos;
))))))
)
)</expression>
    </formulas>
