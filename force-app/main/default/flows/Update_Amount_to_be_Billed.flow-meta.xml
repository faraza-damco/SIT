            </connector>
            <label>Non-IPO Monitoring</label>
        </rules>
        <rules>
            <name>IPO_Monitoring</name>
            <conditionLogic>(1 AND 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IRF_Final_Amount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Billing_Duration__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IRF_Final_Amount__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Billing_Duration__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_1</targetReference>
            </connector>
            <label>IPO Monitoring</label>
        </rules>
        <rules>
            <name>Check_Reset_on_Rejection</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Reset_on_Rejection__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Reset_on_Rejection__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity</targetReference>
            </connector>
            <label>Check Reset_on_Rejection</label>
        </rules>
    </decisions>
    <description>changing it to only for creation from creation &amp; updation
[v6]==&gt; To calculate the Amount to Be Billed for the IPO Monitoring Cases based on the Billing Duration
[v7]==&gt; IPO: Amount to Be Billed</description>
    <environments>Default</environments>
    <formulas>
        <description>Since both the Revised ASF/IRF are not present on the New Business opportunity</description>
        <name>amountToBeBilled_IPO</name>
        <dataType>Currency</dataType>
        <expression>IF(ISPICKVAL({!$Record.Billing_Duration__c}, &apos;Yearly&apos;), 
{!$Record.IRF_Final_Amount__c},
IF(ISPICKVAL({!$Record.Billing_Duration__c}, &apos;Half-Yearly&apos;), 
ROUND({!$Record.IRF_Final_Amount__c}/2,0),
IF(ISPICKVAL({!$Record.Billing_Duration__c}, &apos;Quarterly&apos;), 
ROUND({!$Record.IRF_Final_Amount__c}/4,0),
0)))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Update Amount to be Billed {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Amount to be Billed</label>
    <processMetadataValues>
