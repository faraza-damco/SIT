        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_ASF</targetReference>
        </connector>
        <filterFormula>{!$Record.RecordType.DeveloperName}=&apos;Surveillance&apos;</filterFormula>
        <object>Opportunity</object>
