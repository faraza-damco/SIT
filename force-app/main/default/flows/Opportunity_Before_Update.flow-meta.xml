    <description>v42-Fetch the &apos;Alignment Logic&apos; from the Billing Date object based on the instruments combination
v46-to calculate the billing start/end dates on the New Business Opportunity
v47-Removed the updation of alignment logic for the Surveillance Opportunity
v48-Date of Communication Logic
v49-Updation of the Billing Dates [even when the Billing Dates are not null]
v50-Update Billing Status to Closed Won
v51-Bypass Validation
v52-Calculate the Billing End Date [IPO]
v53-Remove updation of the Billing Dates when PR Date or DoC is updated
v56- Billing End Date</description>
    <environments>Default</environments>
    <formulas>
        <name>billing_end_date</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!billing_start_date},12)-1</expression>
    </formulas>
    <formulas>
        <name>billing_End_Date_IPO</name>
        <dataType>Date</dataType>
        <expression>IF(
  ISPICKVAL({!$Record.Billing_Duration__c}, &apos;Yearly&apos;),
  ADDMONTHS({!$Record.Billing_Start_Date__c}, 12)-1,
  IF(
    ISPICKVAL({!$Record.Billing_Duration__c}, &apos;Half-Yearly&apos;),
    ADDMONTHS({!$Record.Billing_Start_Date__c}, 6)-1,
    IF(
      ISPICKVAL({!$Record.Billing_Duration__c}, &apos;Quarterly&apos;),
      ADDMONTHS({!$Record.Billing_Start_Date__c}, 3)-1,
      null
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>billing_start_date</name>
        <dataType>Date</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.PR_Date__c})), {!$Record.PR_Date__c}, {!$Record.Date_of_Communication__c})</expression>
    </formulas>
    <formulas>
        <name>isLeapYear</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        MOD(YEAR({!billing_start_date}), 4) = 0,
        OR(
            MOD(YEAR({!billing_start_date}), 100) != 0,
            MOD(YEAR({!billing_start_date}), 400) = 0
        ),
        {!billing_start_date} &lt;= DATE(YEAR({!billing_start_date}), 2, 29)
    ),
    AND(
        MOD(YEAR(ADDMONTHS({!billing_start_date}, 12)), 4) = 0,
        OR(
            MOD(YEAR(ADDMONTHS({!billing_start_date}, 12)), 100) != 0,
            MOD(YEAR(ADDMONTHS({!billing_start_date}, 12)), 400) = 0
        ),
        ADDMONTHS({!billing_start_date}, 12) &gt;= DATE(YEAR(ADDMONTHS({!billing_start_date}, 12)), 2, 29)
    ),
    AND(
        YEAR({!billing_start_date}) &lt; YEAR(ADDMONTHS({!billing_start_date}, 12)),
        MOD(YEAR(ADDMONTHS({!billing_start_date}, 12)), 4) = 0,
        OR(
            MOD(YEAR(ADDMONTHS({!billing_start_date}, 12)), 100) != 0,
            MOD(YEAR(ADDMONTHS({!billing_start_date}, 12)), 400) = 0
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>varAgeing</name>
        <dataType>Number</dataType>
