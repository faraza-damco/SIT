        <label>VoD cannot be updated</label>
        <locationX>578</locationX>
        <locationY>503</locationY>
        <customErrorMessages>
            <errorMessage>VoD cannot be updated if the Instrument 4 value is: Issuer Rating, Resolution Plan, Mutual Fund Rating. Please Contact System Administrator !!</errorMessage>
            <fieldSelection>VoD_in_crore__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
