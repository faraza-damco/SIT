    <customErrors>
        <name>Check_VoD1</name>
        <label>Check VoD</label>
        <locationX>842</locationX>
        <locationY>503</locationY>
        <customErrorMessages>
            <errorMessage>Put VoD value as zero if the Instrument 4 value is: Issuer Rating, Resolution Plan, Mutual Fund Rating to proceed further</errorMessage>
            <fieldSelection>VoD_in_crore__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
