<aura:component controller="ws_con_PushToiFlow" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <aura:attribute name="recordId" type="String"/>
	<aura:handler name="init" value="{!this}" action="{!c.doInit}"/>        
    <aura:attribute name="errorMessages" type="List" />
    <aura:attribute name="visible" type="Boolean" default="false" />
    <aura:attribute name="popUp" type="Boolean" default="false" />
    <aura:attribute name="Spinner" type="boolean" default="false"/>

        <aura:if isTrue="{!v.Spinner}">
            <div class="slds-spinner_container slds-spinner--brand slds-spinner">
                <lightning:spinner alternativeText="Loading" size="medium" />
                <div class="slds-spinner__dot-a"></div>
                <div class="slds-spinner__dot-b"></div>
            </div>
        </aura:if>
        <aura:if isTrue="{!v.visible}">
            <ul>
                <aura:iteration items="{!v.errorMessages}" var="error">
                    <li style="color: red;">{!error}</li>
                </aura:iteration>
            </ul>
        </aura:if>

        <br/>
        <br/>
        <br/>
        <br/>
        <aura:if isTrue="{!v.popUp}">
            <ul style="text-align: center;">
                <lightning:button variant="brand" label="Yes" title="Yes" onclick="{!c.handleYes}" />
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <lightning:button variant="Destructive" label="No" title="No" onclick="{!c.handleNo}" />
            </ul>
        </aura:if>
</aura:component>