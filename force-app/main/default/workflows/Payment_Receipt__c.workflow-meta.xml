        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Opportunity__c</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_SGST_Amount</fullName>
        <description>Update Payment receipt SGST Amount on Opportunity Object</description>
        <field>Payment_Receipt_SGST__c</field>
        <formula>SGST_UTGST_Payable__c</formula>
        <name>Update SGST Amount</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Opportunity__c</targetObject>
    </fieldUpdates>
    <rules>
        <fullName>Fields update on Opportunity</fullName>
        <actions>
            <name>Update_Base_Amount</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_CGST_Amount</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_IGST_Amount</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_SGST_Amount</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Name</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>When Payment Receipt is created Update base , ISGT, SGST and CGST amount on Opportunity</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
