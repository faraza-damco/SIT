        <div id="erMsg" class="slds-notify slds-notify_alert slds-alert_error" role="alert" style="display:none">
            <span class="slds-assistive-text">error</span>
            <span class="slds-icon_container slds-icon-utility-error slds-m-right_x-small" title="Description of icon when needed">
                
            </span>
            <h2 id="ErrorMsg" > </h2>
            <div class="slds-notify__close">
                <button class="slds-button slds-button_icon slds-button_icon-small slds-button_icon-inverse" title="Close">
                    
                    <span class="slds-assistive-text">Close</span>
                </button>
            </div>
        </div>
        <h1 id="ErrorMsg" class="slds-text-body_regular" style=" display: block;font-size: 2em;font-weight: bold;margin-block-start: .67em;margin-block-end: .67em;"></h1><br/>
        
        <div class="slds-section slds-is-open">
            <h3 class="slds-section__title">
