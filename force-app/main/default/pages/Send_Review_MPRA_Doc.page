        function SubmitReqisition(){
            debugger;
            var ReqId = "{!Opportunity.Id}";
            var sendmpra=document.getElementById('chkMPRA').checked;
            var sendsow=document.getElementById('chkSOW').checked;
            var accountCity= "{!Opportunity.Account.ShippingCity}";
            var accountStreet= "{!Opportunity.Account.ShippingStreet}";
            var accountState= "{!Opportunity.Account.ShippingState}";
            var accountPostalCode= "{!Opportunity.Account.ShippingPostalcode}";
            var accountCountry= "{!Opportunity.Account.ShippingCountry}";
            var StatementOfWork ="{!Opportunity.Statement_of_Work_No__c}";
            var docname = document.getElementById('{!$Component.docType}').value;//e.options[e.selectedIndex].value;
            if(accountCity=='' && accountStreet=='' && accountState=='' && accountPostalCode=='' && accountCountry==''){
                var msg= 'Register Address is mandatory!!';
                document.getElementById("erMsg").style.display = "block";
                document.getElementById("ErrorMsg").innerHTML=msg;
            }else if(StatementOfWork=='' && sendsow){
                var msg= 'Statement of Work No. is Mandatory !!';
                document.getElementById("erMsg").style.display = "block";
                document.getElementById("ErrorMsg").innerHTML=msg;
                return;
            }
                var resultMessage = sforce.apex.execute("SendProposal","SendMPRAAttachment", {OppotunityId:ReqId,MPRA:sendmpra,SOW:sendsow});
                if (resultMessage == "SUCCESS"){
                    document.getElementById('erMsg').classList.add('slds-theme_success');
                    document.getElementById("erMsg").style.display = "block";
                    document.getElementById("ErrorMsg").innerHTML='Document Sent Successfully !!';
                    //window.location.reload();
                    //window.history.go(-1);
                } else {
                    //alert(resultMessage);
                    document.getElementById("erMsg").style.display = "block";
                    document.getElementById("ErrorMsg").innerHTML=resultMessage;
                }
                return;
            //alert(sendmpra);
        }

        function updateEffectiveDates(){
            debugger;
            var e = document.getElementsByClassName("Docview")[0];
            var docname = e.options[e.selectedIndex].value;
                updateOppDates(docname);
        }

        function updateEffectiveSendDates(){
            debugger;
            var sendmpraDoc=document.getElementById('chkMPRA').checked;
            var sendsowDoc=document.getElementById('chkSOW').checked;
            updateOppEffectiveDatesOnSending(sendmpraDoc,sendsowDoc);
        }
        
