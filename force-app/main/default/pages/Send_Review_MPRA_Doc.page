                </button>
            </h3>
            <div align="center" aria-hidden="false" class="slds-section__content" id="expando-unique-id">
                <b>Select document type for review:  </b>   <apex:selectList id="docType" styleclass="Docview slds-select slds-size_small" label="Select Doc Type:" size="1">
                <apex:selectOption itemLabel="Select document type" itemValue="SelectAnyDoc"/>
                <apex:selectOption itemLabel="MPRA" itemValue="MPRADoc"/>
                <apex:selectOption itemLabel="SOW" itemValue="SowDoc"/>      
                </apex:selectList>
                <br/>
                <br/>
                <br/>
                <apex:commandButton action="{!cancel}"  onclick="updateEffectiveDates(); return PreviewDoc()"  value="Review" oncomplete="Window.close();" styleClass="slds-button slds-button_brand"/>
                <apex:commandButton action="{!cancel}" value="Close" styleClass="slds-button slds-button_brand"/>
                <br/>
            </div>
        </div>
        
        <div class="slds-section slds-is-open">
            <h3 class="slds-section__title">
                <button aria-controls="expando-unique-id" aria-expanded="true" class="slds-button slds-section__title-action">
                    
                    <span class="slds-truncate" title="Section Title">Send MPRA/SOW Document</span>
                </button>
            </h3>
            <div align="center" aria-hidden="false" class="slds-section__content" id="expando-unique-id">
                <b>Select document type for send:  </b>  
                <div class="slds-checkbox">
                    <input type="checkbox" id="chkMPRA" name="options" value="{!sendmpraDoc}"  />     <!--checkbox-unique-id-73-->
                    <label class="slds-checkbox__label" for="chkMPRA">
                        <span class="slds-checkbox_faux"></span>
                        <span class="slds-form-element__label">MPRA</span>
                    </label>
                </div>
                <div class="slds-checkbox">
                    <input type="checkbox" id="chkSOW" value="{!sendsowDoc}" name="options"    />
                    <label class="slds-checkbox__label" for="chkSOW">
                        <span class="slds-checkbox_faux"></span>
                        <span class="slds-form-element__label">SOW</span>
                    </label>
                </div>
                <br/>
                <br/>
                <br/>
                <apex:commandButton action="{!cancel}"  onclick="updateEffectiveSendDates('{!isMPRAChecked} {!isSOWChecked}'); return;" oncomplete="return;" value="Send" styleClass="slds-button slds-button_brand"/>
                <apex:commandButton action="{!cancel}" value="Close" styleClass="slds-button slds-button_brand"/>
                <br/>
            </div>
        </div>
        
        
        
        
        
        
    </apex:form>
</apex:page>