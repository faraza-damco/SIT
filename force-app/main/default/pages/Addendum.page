       <p class="c13"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 182.29px; height: 85.36px;"><img alt="" src="{!URLFOR($Resource.Addendum_Sign,
