               </td>
               <td class="c26" colspan="1" rowspan="1">
                  <p class="c22"><span class="c9">Name of the bank</span></p>
               </td>
               <td class="c16" colspan="1" rowspan="1">
                  <p class="c22"><span class="c9">Amount (Rs. crore)</span></p>
               </td>
            </tr>
