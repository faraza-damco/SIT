      <p class="c1"><span class="c3">This Statement of Work (&ldquo;</span><span class="c5 c3">SOW</span><span class="c3">&rdquo;), effective as of &nbsp;<apex:outputText value="{0,date,dd/MM/yyyy}" rendered="{!Opportunity.SOW_Effective_Date__c!=null}"><apex:param value="{!Opportunity.SOW_Effective_Date__c}" /></apex:outputText>
