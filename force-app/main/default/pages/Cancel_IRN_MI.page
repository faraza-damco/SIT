        <p  style="text-align: center;  font-size: 16pt">
            <apex:outputLabel style="color:red"  rendered="{!errorMsgDisplay!=''}">{!errorMsgDisplay} </apex:outputLabel>
             <apex:outputLabel style="color:#31A608" rendered="{!errorMsgDisplay==''}"> <b> {!Invoice.Invoice.Name}  IRN Canceled .</b> </apex:outputLabel>
        </p>
    </apex:outputText>
-->
</apex:page>
