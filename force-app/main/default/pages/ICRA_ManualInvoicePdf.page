                                            <td class="text-label">:&nbsp;{!invoicePage.manualInvoiceRecord.Bill_No__c}</td>
                                        </tr>
                                        <tr>
                                            <td class="text-label">
                                                <p style="padding:0px;margin:0px;">Dated</p>
