                                            <p style="{!IF(invoicePage.manualInvoiceRecord.RecordType.Name == 'OPE','display: block;','display: none;')}">Kind Attn.&nbsp;:- </p>

                                        </td>
                                        <td class="text-label">
                                            <p>
                                                &nbsp;{!IF(invoicePage.manualInvoiceRecord.RecordType.Name == 'OPE',invoicePage.manualInvoiceRecord.Contact_Name__r.Name,'')}
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-label">
                                            <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>
                                        </td>
                                        <td class="text-label">
                                            <p>
                                                &nbsp;{!IF(invoicePage.manualInvoiceRecord.RecordType.Name == 'OPE',invoicePage.manualInvoiceRecord.Contact_Designation__c,'')}
                                            </p>
                                        </td>
                                    </tr> -->
