                                            <!--p style="width:260px;"-->

                                                {!invoicePage.manualInvoiceRecord.Customer_Name__c}
                                                <br/>
                                                <apex:outputField value="{!invoicePage.manualInvoiceRecord.Address__c}" />
                                                <br/> &nbsp;
                                            <!--/p-->
                                        </td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td class="text-label" style="width:80px; vertical-align:top;">
                                            <p style="padding:0px;margin:0px;">State</p>
                                        </td>
                                        <td class="text-label">
                                            <p style="float: left; ">:&nbsp;</p>
                                            <p style="float: left; width: 70%; padding: 0px; margin: 0px;"> {!invoicePage.manualInvoiceRecord.Customer_State__c}
                                                <br/>(Place of Supply)</p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-label">
                                            <p style="padding:0px;margin:0px;">State Code </p>
                                        </td>
                                        <td class="text-label">:&nbsp;{!IF(invoicePage.manualInvoiceRecord.Customer_State_Code__c
                                            <=0 , '',invoicePage.manualInvoiceRecord.Customer_State_Code__c)}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-label">
                                            <p style="padding:0px;margin:0px;">GSTIN</p>
                                        </td>
                                        <td class="text-label" style="text-transform: uppercase;">:&nbsp;{!invoicePage.manualInvoiceRecord.Customer_GSTIN__c}</td>
