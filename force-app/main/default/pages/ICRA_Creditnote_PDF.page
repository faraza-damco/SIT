                            {!invPage.invRecord.Opportunity_Name__r.Opp_ICRA_Branch__r.Country__c}

                        </p>
                        </td>
                        <td style="text-align: left;color:#0060AA;font-size:10pt;font-weight: 500; ">
                            <p style="width: 80%; ">Tel : {!invPage.invoiceFooter.Telephone__c}</p>
                            <p style="width: 80%; ">CIN : {!invPage.invoiceFooter.CIN__c}</p>
                        </td>
                        <td style="text-align: left;color:#0060AA;font-size:10pt;font-weight: 500; ">
                            <p style="width: 80%; float: right ">Website : {!invPage.invoiceFooter.Website__c}</p>
                            <p style="width: 80%;float: right ">Email : {!invPage.invoiceFooter.Email__c}</p>
                            <p style="width: 80%;float: right ">Helpdesk : {!invPage.invoiceFooter.HelpDesk__c}</p>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3 " style="text-align: left;color:#0060AA;font-size:10pt;font-weight: 500; ">
                            <p> Registered Office:
                            
