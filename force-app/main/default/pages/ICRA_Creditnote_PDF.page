<apex:page renderAs="pdf" standardController="Invoice__c" extensions="ICRA_Controller_CreditNote"  showHeader="false" sidebar="false"
    standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false" docType="html-5.0">
    <html>
        <head>
            <style type="text/css" media="print">
            @font-face {
                font-family: 'myarial';
                src: url("{!$Resource.ICRA}");

            }

            @page {
                size: 8.6in 12.5in;
                margin-top: 3.5cm;
                margin-bottom: 4.5cm;

                @top-center {
                    content: element(header);
                }

                @bottom-center {
                    content: element(footer);
                }

            }

            div.header {
                margin: 30px 0px 20px 0px;
                height: 130px;
                width: 715px;
                text-align: right;
                position: running(header);

            }

            div.footer {
                width: 715px;
                border-top: 2px solid #0027A0;
                position: running(footer);

            }

            body {
                font-family: 'myarial';
                font-size: 8.5pt;
                word-wrap: break-word;
                padding: 0px;
                margin: 0px;
            }

            table {
                word-wrap: break-word;
                font-family: 'myarial';
                border-collapse: collapse;
                table-layout: auto;
                width: 100%;

            }

            td,
            tr {
                word-wrap: break-word;
                padding: 0px 3px 0px 3px;
            }

            .text-label {
                font-weight: bolder !important;
            }

            p {
                padding: 0px;
                margin: 0px;
                line-height: 1.5;
            }

            .custom-border td {
                border: 0.2px solid #aaa9a9;

            }

            .custom-border-table {
                border: 0.2px solid #aaa9a9;

            }

            .text-align {
                text-align: center;
            }
        </style>
        </head>
        <body>
            <div class="header">
                <apex:image value="{!$Resource.ICRA}" width="210px" height="85px" style="float: left;" />
                <!--<p style="text-align: left; color:#0060AA; font-size: 24pt; width: 150px; float: left; margin: 21px 0px 0px 10px;font-weight: 500">
                ICRA
            </p>-->
                <p style="text-align: right; color:#0060AA; font-size: 24pt; width: 350px; float: right; margin: 21px 0px 0px 0px;font-weight: 500">
                ICRA Limited
            </p>
            </div>
            <div class="footer ">
                <table cellspacing="0 " cellpadding="0 " style=" table-layout: fixed; ">
                    <tr>
                        <td style="text-align: left;color:#0060AA;font-size:10pt;font-weight: 500; ">
