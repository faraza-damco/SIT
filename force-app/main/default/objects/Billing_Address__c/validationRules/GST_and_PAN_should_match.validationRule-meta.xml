<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GST_and_PAN_should_match</fullName>
    <active>true</active>
    <description>PAN on Account should match with the GST on Billing Address</description>
    <errorConditionFormula>if(AND(NOT(ISBLANK(GSTN__c)),NOT(ISBLANK(Account_Name__r.PAN_Number__c)),MID (GSTN__c,3,10) &lt;&gt; Account_Name__r.PAN_Number__c),true,false)</errorConditionFormula>
    <errorDisplayField>GSTN__c</errorDisplayField>
    <errorMessage>PAN number or GST number is invalid. GST number should contain PAN Number</errorMessage>
</ValidationRule>
