<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rated_Amount__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
				NOT(ISBLANK(Opportunity_Name__r.Size_to_be_rated_this_year_in_Cr_M__c)), 
				Opportunity_Name__r.Size_to_be_rated_this_year_in_Cr_M__c,
				Opportunity_Name__r.VoD_in_crore__c
)</formula>
    <inlineHelpText>If on the Opportunity, user has input Revised Rated VoD, its value will be displayed in the Rated Amount in Invoice Line Item, else, Volume of Debt (in Crore) will be considered.</inlineHelpText>
    <label>Rated Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
