<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_of_Days__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
AND(ISPICKVAL(Opportunity_Name__r.Business_Segment__c, &apos;Research&apos;), Opportunity_Name__r.RecordType.Name ==&apos;New Business&apos;),
( Opportunity_Name__r.Subscription_End_Date__c - Opportunity_Name__r.Subscription_Start_Date__c) + 1 ,
(Period_of_Rating_Fees_To_Date__c - Period_of_Rating_Fees_From_Date__c) + 1
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>No of Days</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
