<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_field_can_be_blank</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISBLANK(Business_Head__c)  ,
 ISBLANK(ICRA_Branch__c	),
 ISBLANK(OFAC_Approver__c),
