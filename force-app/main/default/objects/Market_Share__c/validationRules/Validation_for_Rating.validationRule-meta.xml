<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_for_Rating</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(LT_Rating__c,&quot;&quot;), ISPICKVAL(MT_Rating__c,&quot;&quot;),
ISPICKVAL(ST_Rating__c,&quot;&quot;),
ISPICKVAL(Other_Ratings__c,&quot;&quot;)
)</errorConditionFormula>
    <errorMessage>Please fill at least one rating</errorMessage>
</ValidationRule>
