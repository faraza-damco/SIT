<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>InterBranch_Particulars_is_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
RecordType.Name = &quot;Inter-Branch Invoice&quot;,
ISBLANK(Particulars__c)
)</errorConditionFormula>
    <errorDisplayField>Particulars__c</errorDisplayField>
    <errorMessage>Particulars is a Mandatory field. Kindly input the same.</errorMessage>
</ValidationRule>
